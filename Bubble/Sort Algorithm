using System;

public class HelloWorld {
    public static void Main(string[] args) {
    int[] arr={5, 3, 8, 1, 2};
    int n=arr.Length-1;
    for(int i=0;i<n;i++){
        for(int j=0;j<n-i;j++){
            if(arr[j]>arr[j+1]){
            int temp=arr[j];
            arr[j]=arr[j+1];
            arr[j+1]=temp;
        }
    }
    }
        for(int i=0;i<arr.Length;i++){
            Console.Write(arr[i]+" ");
        }
    }
}
