using System;

public class HelloWorld {
    public static void Main(string[] args) {
    int[] arr={5, 3, 8, 1, 2};
    int n=arr.Length;
    for(int i=1;i<n;i++){
        int target=arr[i];
        int j=i-1;
        while(j>=0 && arr[j]>target){
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=target;
    }
        for(int i=0;i<arr.Length;i++){
        Console.Write(arr[i]+" ");
    }
}
}
