using System;

public class HelloWorld {
    public static void Main(string[] args) {
    int [] arr={5,7,7,8,8,10};
    int n=arr.Length;
    int low=0;
    int high=n-1;
    int first=-1;
    int target=8;
    while(low<=high){
    int mid=(low+high)/2;
    if(arr[mid]==target){
      first=mid;
      high=mid-1;
    }
    else if(arr[mid]<target){
        low=mid+1;
    }
        else{
            high=mid-1;
        }
    }
     low=0;
     high=n-1;
    int last=-1;
    while(low<=high){
        int mid=(low+high)/2;
        if(arr[mid]==target){
            last=mid;
            low=mid+1;
        }
        else if(arr[mid]<target){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
        Console.WriteLine("[" + first + "," + last + "]");
    }
}
