namespace HelloWorld
{
	public class Program
	{
		public static void Main(string[] args)
		{
		int [] arr={1,2,3,1};
		int n=arr.Length;
		for(int i=0;i<n;i++){
		bool left=(i==0 || arr[i]>arr[i-1]);
		bool right=(i==n-1|| arr[i]>arr[i+1]);
		if(right && left){
			Console.Write(i);
		}
		}
		
}
	}
